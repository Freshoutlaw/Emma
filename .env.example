# Emma AI Environment Variables
# Copy this file to .env and fill in your actual values
# The .env file is already in .gitignore and will not be committed

# --- Application ---
EMMA_APP_NAME=emma-ai
EMMA_VERSION=0.1.0
EMMA_HOST=0.0.0.0
EMMA_PORT=8000
# EMMA_API_KEY=your_api_key_here  # Optional: when set, all /api/* requests need X-API-Key header
EMMA_DOMAIN=localhost  # Used for LLM routing (localhost = local, onrender.com = cloud)

# --- LLM Providers ---
# Groq API Key (cloud LLM provider)
# GROQ_API_KEY=your_groq_api_key_here
# Alternative: EMMA_GROQ_API_KEY=your_groq_api_key_here

# Deepgram API Key (speech-to-text and text-to-speech)
DEEPGRAM_API_KEY=0a18ba354d758db791ca48cf680a44711b49887e
# Alternative: EMMA_DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Deepgram models
EMMA_DEEPGRAM_STT_MODEL=nova-2
EMMA_DEEPGRAM_TTS_MODEL=aura-asteria-en
EMMA_DEEPGRAM_TTS_VOICE=aura-asteria-en

# Ollama configuration
EMMA_OLLAMA_URL=http://localhost:11434
# Ollama Cloud model (tried FIRST before local fallback)
EMMA_OLLAMA_CLOUD_MODEL=gemma4:31b-cloud
# Local model (fallback when cloud quota/rate-limit runs out)
EMMA_LOCAL_MODEL=qwen3.5:2b

# Cloud model configuration (Groq - only if using Groq)
# EMMA_CLOUD_MODEL=llama-3.3-70b-versatile
EMMA_EMBEDDING_MODEL=nomic-embed-text
EMMA_EMBEDDING_DIM=768

# Ollama memory footprint (optional - leave unset for server defaults)
# EMMA_OLLAMA_NUM_CTX=2048
# EMMA_OLLAMA_NUM_GPU=0
# EMMA_OLLAMA_KEEP_ALIVE=180

# --- Security ---
EMMA_CONSENT_MODE=once  # auto | once | strict
EMMA_APPROVAL_TTL=3600  # seconds an approved action stays approved
EMMA_AUDIT_MAX_ENTRIES=5000
EMMA_NETWORK_GATE_OPEN=true
# EMMA_MASTER_KEY=your_master_key_here  # Optional: master key for sensitive operations

# --- Memory (Supabase) - Optional for cloud memory sync ---
# Required for pgvector memory sync. Apply the schema from infrastructure/supabase/schema.sql
EMMA_SUPABASE_URL=https://your-project.supabase.co
EMMA_SUPABASE_ANON_KEY=your_supabase_anon_key_here
EMMA_SUPABASE_SERVICE_KEY=your_supabase_service_key_here
EMMA_SUPABASE_QUERY_DSN=postgresql://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres
# Note: Query DSN is required for Emma to auto-apply the schema. Get it from Supabase dashboard.

# --- Board of Advisors ---
EMMA_BOARD_COST_CEILING_USD=0.50  # per meeting; zero means no meeting at all
EMMA_BOARD_MAX_SEATS=4

# --- MQTT (Home Automation) ---
EMMA_MQTT_HOST=localhost
EMMA_MQTT_PORT=1883
# EMMA_MQTT_USER=your_mqtt_user
# EMMA_MQTT_PASSWORD=your_mqtt_password
EMMA_MQTT_TOPIC_PREFIX=emma

# --- Voice ---
EMMA_TTS_VOICE=en-US-JennyNeural

# --- Voice VAD (Voice Activity Detection)
EMMA_VOICE_VAD_THRESHOLD=0.5  # Silero VAD sensitivity (0.0-1.0, higher = more sensitive)
EMMA_VOICE_SILENCE_DURATION_MS=1500  # ms of sustained silence before ending utterance
EMMA_VOICE_MAX_DURATION_MS=60000  # max utterance duration (60s safety cap)

# --- Platform Detection ---
# RENDER=true  # Automatically set when running on Render.com
